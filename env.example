# ════════════════════════════════════════════════════════════════
# .env.example — Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env asli ke Git/GitHub.
# ════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────
PORT=3000

# Daftar origin frontend yang diizinkan (pisah koma, tanpa spasi).
# Contoh: https://app.vercel.app,https://staging.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── JWT Auth ─────────────────────────────────────────────────────
# Gunakan string panjang acak, minimal 32 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# ── Database (Neon PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Multi-database Neon: gunakan DATABASE_URLS_FILE untuk sampai 1000 URL.
DB_MAX_SLOTS=1000
# Application-level target: 5000 MB decimal = 5,000,000,000 bytes.
# Neon actual storage and billing remain governed by the selected Neon plan.
DB_QUOTA_BYTES=5000000000

# ── Gemini API (Google AI) ───────────────────────────────────────
# Key utama (digunakan langsung oleh server jika tidak ada pool).
GEMINI_API_KEY=

# Model Gemini yang digunakan (opsional, default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Pool key Gemini — pisah koma, tanpa spasi.
# Contoh: GEMINI_POOL_SEED=AIzaSy...,AIzaSy...
# Kosongkan jika ingin mengelola key hanya lewat panel Admin.
GEMINI_POOL_SEED=

# ── OpenAI API (opsional, untuk fallback GPT) ────────────────────
OPENAI_API_KEY=

# ── Email report sender (Resend) ───────────────────────────────────
# Wajib diisi agar fitur laporan via form bisa mengirim email ke admin.
# Gunakan format valid: email@example.com atau Nama <email@example.com>
# Untuk test awal, Resend menyediakan onboarding@resend.dev.
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=BAPPERIDA <onboarding@resend.dev>

# -- Deploy di Vercel ----------------------------------------------------------
# Wajib diisi di Vercel > Project > Settings > Environment Variables.
# Pakai DATABASE_URL / GEMINI_POOL_SEED (env). DATABASE_URLS_FILE tidak bisa
# dipakai karena Vercel tidak menyimpan file di luar bundel deploy.
# ALLOWED_ORIGINS harus berisi domain frontend Vercel (tanpa slash di akhir).
# CRON_SECRET: string acak; Vercel otomatis mengirimnya ke /api/cron/maintenance.
CRON_SECRET=
